    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.4",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
