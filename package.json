{
  "name": "el-asadero",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "test": "node --test tests/game.test.mjs tests/quality.test.mjs tests/motion.test.mjs",
    "test:browser": "node tests/game.browser.cjs",
    "lint": "eslint assets/js tests eslint.config.js --max-warnings=0",
