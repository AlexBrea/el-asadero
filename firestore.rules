rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ranking/{uid} {
      allow read: if true;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username','best','updatedAt','playSec','runSec','build','xp','skin'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.username == request.auth.token.email.split('@')[0]
        && request.resource.data.best is int
        && request.resource.data.best >= 1 && request.resource.data.best <= 5
        && request.resource.data.playSec is number
        && request.resource.data.playSec >= 0 && request.resource.data.playSec <= 86400
        && request.resource.data.runSec is number
        && request.resource.data.runSec >= 0 && request.resource.data.runSec <= 10000000
        && request.resource.data.build is string && request.resource.data.build.size() <= 400
        && request.resource.data.updatedAt == request.time
        && (!('xp' in request.resource.data) || (request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 3000))
        && (!('skin' in request.resource.data) || (request.resource.data.skin is string && request.resource.data.skin.size() <= 20));

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['best','updatedAt','playSec','runSec','build','xp','skin'])
        && request.resource.data.username == resource.data.username
        && request.resource.data.playSec is number
        && request.resource.data.playSec >= resource.data.get('playSec', 0)
        && request.resource.data.playSec <= resource.data.get('playSec', 0) + 86400
        && request.resource.data.runSec is number
        && request.resource.data.runSec >= 0 && request.resource.data.runSec <= 10000000
        && request.resource.data.build is string && request.resource.data.build.size() <= 400
        && (!('xp' in request.resource.data) || (
          request.resource.data.xp is int
          && request.resource.data.xp >= resource.data.get('xp', 0)
          && request.resource.data.xp <= resource.data.get('xp', 0) + 3000
        ))
        && (!('skin' in request.resource.data) || (
          request.resource.data.skin is string && request.resource.data.skin.size() <= 20
        ))
        && (
          request.resource.data.best == resource.data.best
          || (
            request.resource.data.best is int
            && request.resource.data.best > resource.data.best
            && request.resource.data.best <= resource.data.best + 5
            && request.resource.data.best <= 500
            && request.resource.data.updatedAt == request.time
            && request.time > resource.data.get('updatedAt', timestamp.date(2000,1,1)) + duration.value(4, 's')
          )
        );

      allow delete: if false;
    }

    // Datos privados del jugador: nombre del pollo, estadisticas/logros y partida en curso.
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','st','run','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.st is map
        && request.resource.data.run is string && request.resource.data.run.size() <= 30000
        && request.resource.data.ts is number;
      allow delete: if false;
    }
  }
}
